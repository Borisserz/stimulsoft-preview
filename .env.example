# Скопируй в .env рядом с view_dashboard.py (в git не попадает).

MRT_PATH=local/dashboard.mrt

STIMULSOFT_DASHBOARDS_LICENSE_KEY=
STIMULSOFT_REPORTS_LICENSE_KEY=

# Вариант 1 — одной строкой:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Вариант 2 — полями (как в DBeaver / db.env):
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

VIEWER_HOST=127.0.0.1
VIEWER_PORT=8040
VIEWER_OPEN=1
